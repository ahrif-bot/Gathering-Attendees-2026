[{"id": 1, "name": "Ali Prato", "bio": "Ali Prato is an award-winning journalist and mama-of-two who went through secondary infertility, IUIs, IVF, depression, grief and relationship issues. Ali launched her podcast, Infertile AF, in 2019 — and today, she has published more than 275 episodes and garnered more than 1.3 million global downloads. In 2020, Ali and Blair Nelson co-founded Fertility Rally, a safe, all-inclusive 24/7 community for anyone and everyone navigating infertility or building their modern families through ART (Assisted Reproductive Technology). In 2023, she published “Work of ART,” Ali’s children’s book about IVF. Previously, Ali spent 20+ years as a writer and editor specializing in entertainment and celebrity journalism for Playboy, Health, Rolling Stone, Cosmopolitan, Harper’s Bazaar, Page Six Magazine and Teen Vogue", "excerpt": "Ali Prato is an award-winning journalist and mama-of-two who went through secondary infertility, IUIs, IVF, depression, grief and relationship issues.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/alison-prato-1699967/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.infertileafgroup.com", "label": "infertileafgroup.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/aliprato", "label": "@aliprato"}], "photo": "/_blob/556de20d818c4541e83d6f5c25bc0111", "initials": "AP", "tags": ["podcasting", "communities", "authors", "journalism"], "sortKey": "ali prato"}, {"id": 2, "name": "Alicia McKenzie", "bio": "Alicia McKenzie is an author, entrepreneur, and nonprofit founder based in McLean, Virginia. She is the creator of She's Built Different, a Substack publication for women building businesses, income streams, and full lives without burning out. She is also the Executive Director and Co-Founder of The Next ChaptHER Foundation, a 501(c)(3) nonprofit providing women with community, connection, and capital during major life transitions. A former competitive USAW athlete turned multi-business entrepreneur, Alicia co-hosts the podcast Married to the Startup with her husband George and is the author of Balance Is Bullsh*t and the children's book These ABCs Belong to Me. She is a wife and mother of five.", "excerpt": "Alicia McKenzie is an author, entrepreneur, and nonprofit founder based in McLean, Virginia.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/liftlikeamother/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.aliciamckenzie.com", "label": "aliciamckenzie.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/aliciagmckenzie/", "label": "@aliciagmckenzie"}], "photo": "/_blob/01b1266500548536e5f14ade3bc14d79", "initials": "AM", "tags": ["newsletters", "podcasting", "founders", "authors"], "sortKey": "alicia mckenzie"}, {"id": 3, "name": "Amanda Northcutt", "bio": "I'm Founder & CEO of LevelUp. Over 20 years helping 200+ companies as a consultant or fractional executive, I've found that the #1 struggle standing between brilliant people and a successful and personally fulfilling business is biz dev, aka sales. So I'm laser focused on helping independent B2B coaches, consultants, and micro-boutiques create consistent, predictable, recurring revenue engines inside of a business the founder actually loves.", "excerpt": "I'm Founder & CEO of LevelUp. Over 20 years helping 200+ companies as a consultant or fractional executive, I've found that the #1 struggle…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/northcuttamanda/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://meetlevelup.com", "label": "meetlevelup.com"}], "photo": "/_blob/d6da060c3eb7cfc4afe874e9db7d6fbc", "initials": "AN", "tags": ["founders", "advisory"], "sortKey": "amanda northcutt"}, {"id": 4, "name": "Ambika Nigam", "bio": "Ambika currently leads Premium Content Partnerships at LinkedIn, where she focuses on Creator Monetization, helping creators build, grow, and monetize their businesses on the platform.\n\nPrior to LinkedIn, Ambika co-founded and served as CEO of Zeit, where she led product, sales, and fundraising strategy, scaling the platform to more than 10,000 job seekers and partnering with dozens of companies to improve career discovery and candidate fit.\n\nPreviously, she led an award-winning team of 20+ product, design, and engineering professionals at Bloomberg Media, overseeing a $50M+ portfolio of digital products across mobile, web, and connected devices serving more than 1M users. She also launched Bloomberg Media's first venture studio and UX research practice.\n\nEarlier in her career, Ambika led the Business Design discipline in New York and held marketing strategy leadership roles at Ogilvy. Across startups and Fortune 500 companies, she has built and scaled products spanning the future of work, media, consumer, and education sectors, with a focus on bringing complex ideas to market through cross-functional collaboration.", "excerpt": "Ambika currently leads Premium Content Partnerships at LinkedIn, where she focuses on Creator Monetization, helping creators build, grow…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/ambikanigam/?isSelfProfile=true", "label": "LinkedIn"}], "photo": "/_blob/4a827b23e2a6ab4322417acd873905c2", "initials": "AN", "tags": ["founders"], "sortKey": "ambika nigam"}, {"id": 6, "name": "Amy Emmerich", "bio": "Former CEO Miss Universe Organization and Global President Refinery29. Currently building MRock Partners, providing fractional GM leadership and strategic advisory to founder-led startups and high-growth consumer brands across CPG, media,\nand emerging tech.", "excerpt": "Former CEO Miss Universe Organization and Global President Refinery29.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/amyemmerich/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.amyemmerich.com", "label": "amyemmerich.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/amyemmerich/", "label": "@amyemmerich"}], "photo": "/_blob/e7bde8965a400e68f59747976fa2394d", "initials": "AE", "tags": ["founders", "advisory"], "sortKey": "amy emmerich"}, {"id": 7, "name": "Amy Nelson", "bio": "Amy Nelson is a former corporate litigator, the founder of The Riveter (a venture-backed company that raised $30M), and the host of Target, a new podcast with former federal prosecutor Alex Little. After her family survived a four-year federal investigation and civil forfeiture fight, she now advises founders, executives, and high-profile individuals through their highest-stakes moments, and advocates for criminal justice reform. She’s a mom of four. (Yes, all at once.) Amy has written for Forbes, Newsweek, The Washington Post, and The Seattle Times, and previously hosted an iHeartRadio podcast. She has spoken at Fortune’s Most Powerful Women, Cannes Lions, and SXSW, and has been featured on the TODAY show, Bloomberg, Refinery29, and BuzzFeed. Every day, she talks with her community of more than 500,000 followers across TikTok, Instagram, and X.", "excerpt": "Amy Nelson is a former corporate litigator, the founder of The Riveter (a venture-backed company that raised $30M), and the host of Target, a new podcast with former federal prosecutor Alex Little.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/amynelsonriveter/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.riveterventures.co", "label": "riveterventures.co"}, {"kind": "Instagram", "href": "https://www.instagram.com/amy_k_nelson", "label": "@amy_k_nelson"}], "photo": "/_blob/a11ce5017a0c0ffee0a123456789abcd", "initials": "AN", "tags": ["podcasting", "founders", "authors", "advisory"], "sortKey": "amy nelson"}, {"id": 9, "name": "Amy Shoenthal", "bio": "Amy Shoenthal is the USA TODAY bestselling author of The Setback Cycle, a book about how today’s prominent founders and leaders overcome obstacles to find success. She's also a sought after leadership coach, TEDx and corporate speaker. Her newsletter, The Sunday Setup, offers an antidote to the “Sunday Scaries,” helping thousands of people set up their schedules so they can reclaim time in their busy weeks and bring more fulfillment to their lives. Amy also hosts a salon series: From Setbacks to Setups, which brings together curated groups of professionals to talk honestly about pivots, disruption, and what comes next.", "excerpt": "Amy Shoenthal is the USA TODAY bestselling author of The Setback Cycle, a book about how today’s prominent founders and leaders overcome…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/amyshoenthal/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://amyshoenthal.substack.com", "label": "amyshoenthal.substack.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/amysho/", "label": "@amysho"}], "photo": "/_blob/02d063d89373dcc9be7e84235504ad50", "initials": "AS", "tags": ["authors", "newsletters", "advisory"], "sortKey": "amy shoenthal"}, {"id": 10, "name": "Anna Blue", "bio": "Anna Blue is a strategist, entrepreneur, and speaker who builds ideas, brands, and experiences that move people to action. She is the Founder & CEO of Blue Moss Group, where she advises organizations and leaders on business strategy, brand, influence, and event curation and growth. She is also the founder of the Hospitality Creator Summit, a first-of-its-kind platform for hospitality creators and industry leaders, and Say, She’s Right, a movement challenging the language and systems that hold women back. Across her work, Anna brings together the right people, ideas, and stories to build communities, grow influence, and turn bold ideas into meaningful impact.", "excerpt": "Anna Blue is a strategist, entrepreneur, and speaker who builds ideas, brands, and experiences that move people to action.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/anna-blue/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.theannablue.com", "label": "theannablue.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/mrsannablue/", "label": "@mrsannablue"}], "photo": "/_blob/f0fd4d1e1c17d3561bf7d5c55de21a63", "initials": "AB", "tags": ["founders", "authors", "communities", "advisory"], "sortKey": "anna blue"}, {"id": 11, "name": "Anne Welsh", "bio": "Dr. Anne Welsh is a clinical psychologist, executive coach, and author of *Ambitious Mother: From Surviving to Thriving in Your Career and at Home*. She serves as a thought partner to women leaders, from founders building their own businesses to executives navigating complex organizations, helping them think differently about ambition, leadership, and how they want to build their careers and lives. A former Harvard psychologist and mother of four, Anne’s work explores sustainable ambition, the psychology of high achievement, and how we can succeed without sacrificing the rest of who we are.", "excerpt": "Dr. Anne Welsh is a clinical psychologist, executive coach, and author of Ambitious Mother: From Surviving to Thriving in Your Career and…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/drannewelsh", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.drannewelsh.com", "label": "drannewelsh.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/drannewelsh/", "label": "@drannewelsh"}], "photo": "/_blob/6fcd0c0065f90c40bc4cebfc49790d2a", "initials": "AW", "tags": ["authors", "advisory"], "sortKey": "anne welsh"}, {"id": 13, "name": "Aransas Savas", "bio": "Aransas Savas is a thought leadership coach, behavioral researcher, and host of the award-winning Uplifters Podcast. She helps women turn hard-won experience into bold platforms. Author of Courage Capital (Hachette, Oct 2027).", "excerpt": "Aransas Savas is a thought leadership coach, behavioral researcher, and host of the award-winning Uplifters Podcast.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/aransassavas/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.aransassavas.com", "label": "aransassavas.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/aransas_savas/", "label": "@aransas_savas"}], "photo": "/_blob/427d4122d383c9a7750d58e8134e7bff", "initials": "AS", "tags": ["podcasting", "authors", "advisory"], "sortKey": "aransas savas"}, {"id": 14, "name": "Bobbi Rebell", "bio": "Bobbi Rebell, CFP®, is the founder of Financial Wellness Strategies, where she leads workshops and keynotes that help employees and organizations build healthier relationships with money. She is also a Certified Financial Therapist, serves as a spokesperson for brands that share her values, and splits her time between New York City and Boca Raton. Bobbi has written two books on money and adulting and has hosted podcasts with more than a million downloads. She is now developing a new podcast with a client and writing her third book, which focuses on financial wellness.", "excerpt": "Bobbi Rebell, CFP®, is the founder of Financial Wellness Strategies, where she leads workshops and keynotes that help employees and…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/bobbirebellkaufman/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://financialwellnessstrategies.com", "label": "financialwellnessstrategies.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/bobbirebell1/", "label": "@bobbirebell1"}], "photo": "/_blob/2d3116d19414617eadff40d9fb063f5c", "initials": "BR", "tags": ["founders", "authors", "podcasting"], "sortKey": "bobbi rebell"}, {"id": 15, "name": "Bridget Todd", "bio": "Host of iHeartRadio's There Are No Girls on the Internet podcast and author of Love at First Prompt: AI and the Future of Intimacy with Simon & Schuster", "excerpt": "Host of iHeartRadio's There Are No Girls on the Internet podcast and author of Love at First Prompt: AI and the Future of Intimacy with…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/bridget-todd-40250044/?isSelfProfile=true", "label": "LinkedIn"}], "photo": "/_blob/c3d9c59683e5dbe0bd598945200e4aba", "initials": "BT", "tags": ["podcasting", "authors"], "sortKey": "bridget todd"}, {"id": 16, "name": "Brigid Schulte", "bio": "Brigid Schulte is an award-winning journalist, keynote speaker and author of Over Work: Transforming the Daily Grind in the Quest for a Better Life and the New York Times bestselling book on time pressure, gender and modern life, Overwhelmed: Work, Love & Play when No One has the Time. She was an award-winning journalist for The Washington Post and part of the team that won the 2008 Pulitzer Prize. She is the director of New America’s Better Life Lab, which produces and supports award-winning research, journalism and practical tools to change narratives and drive action for fairer public policies, workplace practices and cultural attitudes around work, family, gender, care and wellbeing so all people and families have time and a fair opportunity to live rich, full, wholehearted lives. She hosts the Better Life Lab podcast on Slate. Her work has appeared in numerous publications, including the New York Times, the Atlantic, Harvard Business Review, Financial Times, The Guardian, Time, Slate, U.S. News & World Report, CNN, the BBC, Fast Company, New York magazine and many others.\n\nSchulte earned an M.S. at the Columbia Graduate School of Journalism. She lives in Alexandria, Virginia with her husband and their two children.", "excerpt": "Brigid Schulte is an award-winning journalist, keynote speaker and author of Over Work: Transforming the Daily Grind in the Quest for a…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/brigidschulte/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.brigidschulte.com/", "label": "brigidschulte.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/brigidschulte/", "label": "@brigidschulte"}], "photo": "/_blob/3aa7fdf32f57b0e9c18cc368d6a00004", "initials": "BS", "tags": ["journalism", "authors", "podcasting"], "sortKey": "brigid schulte"}, {"id": 17, "name": "Cara Natterson", "bio": "Dr. Cara Natterson is a pediatrician, speaker, educator, and leading voice in tween + teen health. She graduated from Harvard college + Johns Hopkins Medical School, and trained in pediatrics at UCSF. Cara launched her career at Tenth Street Pediatrics in Santa Monica. She traded patient care for writing, and has authored 10 books including the New York Times bestselling The Care and Keeping of You series with American Girl. Since 2021, she + Vanessa Kroll Bennett have collaborated on social channels, podcasts, a growing library of books, and most recently curriculum. It’s all in service to the mission––getting less awkward––which is, conveniently, also the name of their company.", "excerpt": "Dr. Cara Natterson is a pediatrician, speaker, educator, and leading voice in tween + teen health.", "links": [{"kind": "LinkedIn", "href": "https://linkedin.com/in/cara-natterson-md-13aa9552/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://lessawkward.com", "label": "lessawkward.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/caranatterson/", "label": "@caranatterson"}], "photo": "/_blob/bf6aa717000000000000000000001f24", "initials": "CN", "tags": ["authors", "podcasting", "founders"], "sortKey": "cara natterson"}, {"id": 18, "name": "Cara Truitt", "bio": "Cara Truitt is a speaker, communication coach, and the creator of the Choose the One framework. She helps leaders, teams, and organizations communicate with greater clarity, confidence, and presence—whether they’re leading a meeting, facilitating a workshop, or navigating a high-stakes conversation.\n\nOn Hold the Room, Cara brings together experts, thought leaders, and exceptional communicators to unpack the habits, mindsets, and practical skills that help people create trust, foster connection, and communicate in ways that leave a lasting impact.", "excerpt": "Cara Truitt is a speaker, communication coach, and the creator of the Choose the One framework.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/caratruitt/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://caratruitt.com/", "label": "caratruitt.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/caratruitt/", "label": "@caratruitt"}], "photo": "/_blob/cf6bb828000000000000000000002025", "initials": "CT", "tags": ["authors", "advisory"], "sortKey": "cara truitt"}, {"id": 19, "name": "Catherine Connors", "bio": "I'm a former political philosopher and recovering Disney executive who once led a Princess Task Force; my expertise on storytelling and narrative impact runs from academia to entertainment. I now tend imagination ecosystems, working with organizations, individuals, and communities to go deep into the roots of the stories that shape them (and us!) and to create/grow the ones that can shape futures.", "excerpt": "I'm a former political philosopher and recovering Disney executive who once led a Princess Task Force; my expertise on storytelling and…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/catherineconnors/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.catherineconnors.com", "label": "catherineconnors.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/herbadmother/", "label": "@herbadmother"}], "photo": "/_blob/df759e82cd80bb3d923b0f63cd1215a1", "initials": "CC", "tags": ["advisory"], "sortKey": "catherine connors"}, {"id": 20, "name": "Chenell Basilio", "bio": "Chenell Basilio runs Growth In Reverse, where she's reverse-engineered how 80+ creators grew their newsletters. She helps audience-first founders build email lists full of subscribers who actually buy, through her GIR Pro membership and 1:1 newsletter audits. If your list is growing but not converting (or not growing at all), she's your person.", "excerpt": "Chenell Basilio runs Growth In Reverse, where she's reverse-engineered how 80+ creators grew their newsletters.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/chenellco/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://growthinreverse.com", "label": "growthinreverse.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/chenellco/", "label": "@chenellco"}], "photo": "/_blob/ef6dda40000000000000000000002227", "initials": "CB", "tags": ["newsletters", "communities", "advisory", "founders"], "sortKey": "chenell basilio"}, {"id": 21, "name": "Christine Michel Carter", "bio": "Christine Michel Carter is an author, journalist, and marketing executive whose work explores motherhood, caregiving, women’s economic security, and the future of work. A longtime Forbes Senior Contributor, she has written more than 300 articles and has also contributed to TIME and the Los Angeles Times. Her reporting and commentary have been cited in congressional research, legal guidance, academic work, and court filings. She also advises organizations on how culture, technology, and workplace systems shape the lives and careers of women.", "excerpt": "Christine Michel Carter is an author, journalist, and marketing executive whose work explores motherhood, caregiving, women’s economic…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/cmichelcarter", "label": "LinkedIn"}, {"kind": "Instagram", "href": "https://www.instagram.com/cmichelcarter/", "label": "@cmichelcarter"}], "photo": "/_blob/b3dd0605b5556f049ca530150a852340", "initials": "CC", "tags": ["authors", "journalism", "advisory"], "sortKey": "christine michel carter"}, {"id": 22, "name": "Courtney Reimer", "bio": "I’ve been developing podcasts since before most people knew what a podcast was, with stops at Spotify, Audible, MTV, and Discovery along the way. I’ve done strategic audits + launches for Fortune 100 companies, founders, thought leaders, and literal royalty, including Amy’s favorite tidbit: I executive produced Meghan Markle’s Archetypes. These days, I help people with a mission and a message build podcasts that work even harder than they do. I’m also a Gathering repeat offender: last year, I led a workshop on how to make your podcast work harder than you do. Connecting is basically my religion, so by all means, say hi!", "excerpt": "I’ve been developing podcasts since before most people knew what a podcast was, with stops at Spotify, Audible, MTV, and Discovery along the way.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/courtneyreimer/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.soundsgreatstrategy.com", "label": "soundsgreatstrategy.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/soundsgreatcourtney", "label": "@soundsgreatcourtney"}], "photo": "/_blob/b2bb4ca5a4e809e12bffc2c8ad9bf804", "initials": "CR", "tags": ["podcasting", "advisory"], "sortKey": "courtney reimer"}, {"id": 23, "name": "Danielle Hughes", "bio": "Danielle Hughes is the Chief Personality Officer of More Than Words Marketing and creator of the Personality Brand framework. After realizing her own business copy was sounding generic, she cracked the code on integrating authentic personality into professional branding—helping executives and teams leverage who they are as their ultimate competitive edge.", "excerpt": "Danielle Hughes is the Chief Personality Officer of More Than Words Marketing and creator of the Personality Brand framework.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/daniellehughes/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.morethanwordscopy.com/", "label": "morethanwordscopy.com"}], "photo": "/_blob/af6eeb41000000000000000000002328", "initials": "DH", "tags": ["marketing"], "sortKey": "danielle hughes"}, {"id": 24, "name": "Dominique Johnson-Lindsay Peek", "bio": "Dominique Johnson-Lindsay Peek is a marketing leader who works on digital transformation, brand strategy, MarTech and marketing operations across B2B, EdTech and media. She calls herself \"The Martech Matchmaker\" and a \"multihyphenate\". She is a podcaster and hosts \"Active Listener,\" Lightspeed's podcast featuring voices in K-12 education. She was Digital Community Manager at Her Agenda, a platform for ambitious women, where she ran programming that connected women and wrote profiles of founders and creators. Her Agenda describes her as an award-winning marketer and business owner, a University of Alabama at Birmingham graduate, and someone who cares about mentoring the next generation of marketers.", "excerpt": "Dominique Johnson-Lindsay Peek is a marketing leader who works on digital transformation, brand strategy, MarTech and marketing operations across B2B, EdTech and media.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/djohnsonlindsay/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://djohnsonlindsay.com", "label": "djohnsonlindsay.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/djohnsonlindsay", "label": "@djohnsonlindsay"}], "photo": "/_blob/ba588b2e000000000000000000001312", "initials": "DP", "tags": ["podcasting", "communities", "marketing"], "sortKey": "dominique johnson-lindsay peek"}, {"id": 25, "name": "Ellie Wu", "bio": "I am the founder of CSuiteCX, where I help founders, executives, and investors at growth-stage B2B software companies see customer friction before it becomes a risk to revenue and valuation. I built and led customer organizations at SAP Concur and Smartsheet, advised hundreds of venture and private equity-backed companies at Insight Partners, and created a diagnostic that shows companies how to keep and grow their customers. As an immigrant, I learned early to read what goes unsaid, and I built rooms that inspire with TEDxSeattle before starting my practice. Ask me why subscribers quietly leave, and what to do before they do.", "excerpt": "I am the founder of CSuiteCX, where I help founders, executives, and investors at growth-stage B2B software companies see customer friction…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/elliewu/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://csuitecx.com", "label": "csuitecx.com"}], "photo": "/_blob/ce041b1b962f44efa7db076c230d0e81", "initials": "EW", "tags": ["founders", "advisory"], "sortKey": "ellie wu"}, {"id": 26, "name": "Emily Tumis", "bio": "Emily Tumis works with founder-led brands whose marketing and operations feel scattered. She handles both the strategy and the execution, and for many of her clients, she's the one running the day to day, from brand and marketing to the systems that keep the business moving. Think of her as your creative side, and everything else, etc.", "excerpt": "Emily Tumis works with founder-led brands whose marketing and operations feel scattered.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/emily-tumis/", "label": "LinkedIn"}, {"kind": "Website", "href": "http://www.emilytumiscreative.com", "label": "emilytumiscreative.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/emilytumiscreative/", "label": "@emilytumiscreative"}], "photo": "/_blob/cffd5f13cb251dff206bf529fdbce6a4", "initials": "ET", "tags": ["marketing", "advisory"], "sortKey": "emily tumis"}, {"id": 27, "name": "Erin Byrne", "bio": "Former pharma executive turned entrepreneur and academic helping leaders make sustainability and social impact work inside complex organizations. I'm also exploring a bigger question: what happens when individuals define “enough” for themselves and gain the freedom to pursue impact that truly matters?", "excerpt": "Former pharma executive turned entrepreneur and academic helping leaders make sustainability and social impact work inside complex…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/erin-byrne04/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://EBImpactConsulting.com", "label": "ebimpactconsulting.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/elbyrne04/", "label": "@elbyrne04"}], "photo": "/_blob/1fb366855e657e3c24a5d96868ed3cd0", "initials": "EB", "tags": ["founders", "advisory"], "sortKey": "erin byrne"}, {"id": 28, "name": "Erin Souder", "bio": "Erin Souder is a product development and global sourcing executive, entrepreneur, podcast host, and co-founder of The Sourcing Gals, where she helps founders and brands turn ambitious product ideas into commercially viable, scalable businesses. With more than two decades of experience across product development, design, manufacturing, and global sourcing, Erin previously served as Vice President of Product Development at BaubleBar. Erin also co-hosts The Sourcing Gals podcast, where she pulls back the curtain on what it actually takes to create, manufacture, and scale physical products. Based in Columbus, Ohio, she works with brands and manufacturing partners around the world.", "excerpt": "Erin Souder is a product development and global sourcing executive, entrepreneur, podcast host, and co-founder of The Sourcing Gals, where she helps founders…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/erin-souder-a29b885/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://thesourcinggals.com", "label": "thesourcinggals.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/erinlsouder", "label": "@erinlsouder"}], "photo": "/_blob/af730046000000000000000000002833", "initials": "ES", "tags": ["podcasting", "founders", "advisory"], "sortKey": "erin souder"}, {"id": 29, "name": "Francesca Donner", "bio": "Francesca Donner is the founder and editor-in-chief of The Persistent, a women-run media company \"covering women for a change.\" Her LinkedIn lists her as a 2026 Webby Award winner. At The New York Times she was director of women and gender coverage and edited \"In Her Words.\" Earlier, as a deputy editor at The Wall Street Journal, she focused on women and the future of work. She has also been executive editor at Quartz and an editor at Forbes. Her work pushes for more women as quoted experts and subjects in business, politics and culture, and she has written about the pay gap, unpaid labor and caregiving. She grew up partly in England and lives in Sharon, Connecticut.", "excerpt": "Francesca Donner is the founder and editor-in-chief of The Persistent, a women-run media company \"covering women for a change.\" Her LinkedIn lists her as a 2026 Webby Award winner.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/francesca-donner-17b92614/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.thepersistent.com", "label": "thepersistent.com"}], "photo": "/_blob/cb599c3f000000000000000000001413", "initials": "FD", "tags": ["newsletters", "founders", "journalism"], "sortKey": "francesca donner"}, {"id": 30, "name": "Gabrielle Tenaglia", "bio": "Gabrielle Tenaglia is a fractional marketing leader and co-founder of Throughline, a consultancy that helps CMOs, CEOs and founders close the gap between what their brands promise and what they deliver. She is a brand and product marketing consultant for Midi Health, where she wrote the strategy for its first national campaign, \"Midlife Back in Session,\" starring Amy Schumer. Before that, she was the first marketing hire and head of marketing at Lettuce Financial Labs, a tax and accounting product for solopreneurs. She spent about 20 years at creative agencies, most recently as partner and director of brand strategy at twofifteenmccann. She has spoken publicly about fractional work, including freelancing so she could spend summers as an Outward Bound instructor and wanting more flexibility after having children. She is based in the San Francisco Bay Area.", "excerpt": "Gabrielle Tenaglia is a fractional marketing leader and co-founder of Throughline, a consultancy that helps CMOs, CEOs and founders close the gap between what…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/gabrielletenaglia/", "label": "LinkedIn"}], "photo": "/_blob/671f659c7f41407133bb7c1cc625b46a", "initials": "GT", "tags": ["founders", "marketing", "advisory"], "sortKey": "gabrielle tenaglia"}, {"id": 31, "name": "Gala McCray", "bio": "Gala McCray is the founder of Two Arrows, a boutique financial consultancy providing bookkeeping and advisory support to established business owners. Her work helps clients create greater financial clarity, make more confident decisions, and build businesses that support the lives they want to live.", "excerpt": "Gala McCray is the founder of Two Arrows, a boutique financial consultancy providing bookkeeping and advisory support to established…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/galamccray", "label": "LinkedIn"}, {"kind": "Website", "href": "https://twoarrows.co/", "label": "twoarrows.co"}, {"kind": "Instagram", "href": "https://www.instagram.com/twoarrows.co/", "label": "@twoarrows.co"}], "photo": "/_blob/3e197acbc0e99bda97dc2e20d89c518f", "initials": "GM", "tags": ["founders", "advisory"], "sortKey": "gala mccray"}, {"id": 33, "name": "Gretchen Rubin", "bio": "Gretchen Rubin is a writer on happiness, habits and human nature. She has written five New York Times bestsellers, including the #1 bestseller \"The Happiness Project,\" and her books have sold more than 3.5 million copies in over 30 languages. She hosts the award-winning podcast \"Happier with Gretchen Rubin\" with her sister, TV show-runner Elizabeth Craft. The podcast has passed 280 million downloads. She also co-hosts the advice podcast \"Since You Asked\" with psychotherapist Lori Gottlieb. Her other books include \"Better Than Before,\" \"The Four Tendencies,\" \"Outer Order, Inner Calm,\" \"Life in Five Senses\" and \"Secrets of Adulthood.\" She started out in law: she graduated from Yale and Yale Law School, was editor-in-chief of the Yale Law Journal, and clerked for Justice Sandra Day O'Connor.", "excerpt": "Gretchen Rubin is a writer on happiness, habits and human nature.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/gretchenrubin/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://gretchenrubin.com", "label": "gretchenrubin.com"}], "photo": "/_blob/e64290971c37f5004890a67108b9e739", "initials": "GR", "tags": ["podcasting", "authors"], "sortKey": "gretchen rubin"}, {"id": 34, "name": "Haley Janicek", "bio": "Haley Janicek is the Head of Creator Community at Kit. She built and leads Kit Studios in Boise, Chicago, and NYC, and runs Kit's annual Craft & Commerce conference. A Division I volleyball Hall of Fame athlete at the University of Idaho and the former youngest D1 head coach in the NCAA, she now speaks on why women should stop treating competition like a dirty word. She lives in Boise with her husband and three kids.", "excerpt": "Haley Janicek is the Head of Creator Community at Kit. She built and leads Kit Studios in Boise, Chicago, and NYC, and runs Kit's annual Craft & Commerce conference.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/haley-janicek/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.kit.com", "label": "kit.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/haleyjani", "label": "@haleyjani"}], "photo": "/_blob/7b31850d62a2c839eaae99f767351caa", "initials": "HJ", "tags": ["communities", "authors"], "sortKey": "haley janicek"}, {"id": 35, "name": "Hannah Soto", "bio": "Hannah Soto is a five-time entrepreneur, executive coach and speaker who works with founders on leadership, vision, delegation and resilience. In 2014 she started a photo and video production company from zero clients, originally called Grey House Productions and now The Arridia Group. She grew it into a multi-seven-figure business with clients including Apple, Google, Nike, Mattel and Marriott. She also co-founded Forward Fund Chicago, which funded creative projects and businesses by women and nonbinary people. She has spoken at the ANA, AIMM and Calm Company's Founder Summit, including on founder burnout. She often talks about how walking the Camino de Santiago changed her relationship with suffering and \"becoming.\"", "excerpt": "Hannah Soto is a five-time entrepreneur, executive coach and speaker who works with founders on leadership, vision, delegation and resilience.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/hellohannahsoto/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.hellohannahsoto.com", "label": "hellohannahsoto.com"}], "photo": "/_blob/dc600d40000000000000000000001514", "initials": "HS", "tags": ["founders", "authors", "advisory"], "sortKey": "hannah soto"}, {"id": 36, "name": "Helen Krug von Nidda", "bio": "Dr. Helen Krug von Nidda is an author, executive coach, and international speaker specializing in leadership development, career empowerment for women, and workplace culture. She has over 20 years of global HR experience spanning the United Nations system and Fortune 500 companies. She holds a Doctorate in Education from Columbia University and licensed career counselor, and currently teaches at Stanford University. Her book, Closing the Fulfillment Gap, was released September 15, 2026 by Post Hill Press, distributed by Simon & Schuster", "excerpt": "Dr. Helen Krug von Nidda is an author, executive coach, and international speaker specializing in leadership development, career empowerment for women, and workplace culture.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/helenkrugvonnidda/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.with-helen.com", "label": "with-helen.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/with.dr.helen", "label": "@with.dr.helen"}], "photo": "/_blob/af699606000000000000000000001e23", "initials": "HN", "tags": ["authors", "advisory"], "sortKey": "helen krug von nidda"}, {"id": 37, "name": "Helena Bottemiller Evich", "bio": "Helena Bottemiller Evich is an award-winning journalist and the founder and editor-in-chief of Food Fix, a must-read newsletter focused on food policy. Helena has become one of the most trusted voices on food issues in America. She previously led coverage of food and agriculture policy at POLITICO for nearly a decade, winning numerous awards for her work, including a George Polk Award for a series on climate change and two James Beard Awards for features on nutrition and science. She's a sought after speaker and commentator, appearing on CNN, NBC, CBS, BBC and NPR, among others. Her work is widely cited in the media and has also been published in the New York Times, the Columbia Journalism Review and NBC News.", "excerpt": "Helena Bottemiller Evich is an award-winning journalist and the founder and editor-in-chief of Food Fix, a must-read newsletter focused on…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/helena-bottemiller-evich/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://foodfix.co", "label": "foodfix.co"}, {"kind": "Instagram", "href": "https://www.instagram.com/heleenabena/", "label": "@heleenabena"}], "photo": "/_blob/d8472b9d715d7674e970bd439dbf935d", "initials": "HE", "tags": ["journalism", "newsletters", "founders", "authors"], "sortKey": "helena bottemiller evich"}, {"id": 38, "name": "Henah Velez", "bio": "Henah Velez is a writer, editor, and producer. She's the writer behind Departure, a weekly newsletter focused on travel for women, and a Managing Producer at Morning Brew, Inc. focused on B2B content. Previously, she was the Executive Producer of The Money with Katie Show, and an editor at The Good Trade, a lifestyle publication focused on sustainability and ethical fashion. She holds a dual-BA in Psychology and Communication from Rutgers University, and a Master's Degree in Social Entrepreneurship and Impact from Pepperdine University.", "excerpt": "Henah Velez is a writer, editor, and producer. She's the writer behind Departure, a weekly newsletter focused on travel for women, and a…", "links": [{"kind": "LinkedIn", "href": "https://linkedin.com/in/henahvelez", "label": "LinkedIn"}, {"kind": "Website", "href": "https://joindeparture.com", "label": "joindeparture.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/henah/", "label": "@henah"}], "photo": "/_blob/c2210237f72cbf0acecff997f913804b", "initials": "HV", "tags": ["newsletters", "podcasting", "journalism"], "sortKey": "henah velez"}, {"id": 39, "name": "Hitha Palepu", "bio": "Hitha Palepu is an entrepreneur, investor, author, and speaker, and the CEO of Rhoshan Pharmaceuticals, whose lead product is injectable aspirin for hospital use. She is a two-time author and is currently building Hyphenated, a content and community platform helping women embrace all of their roles instead of being boxed into one.", "excerpt": "Hitha Palepu is an entrepreneur, investor, author, and speaker, and the CEO of Rhoshan Pharmaceuticals, whose lead product is injectable…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/hithapalepu", "label": "LinkedIn"}, {"kind": "Website", "href": "https://hitha.substack.com", "label": "hitha.substack.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/hithapalepu/", "label": "@hithapalepu"}], "photo": "/_blob/cf750248000000000000000000003035", "initials": "HP", "tags": ["founders", "authors", "communities"], "sortKey": "hitha palepu"}, {"id": 40, "name": "Jackie Hutson", "bio": "Jackie Hutson is a Central Ohio entrepreneur and product and merchandising expert. She co-hosts The Sourcing Gals Podcast, launched in March 2025, and founded the brand Piper & Mint in 2024. She spent about two decades in Columbus-area retail. She started as a merchant at Abercrombie & Fitch, then held senior merchant and merchandise manager roles at The Limited and was a senior buyer at Tween Brands. She is also the founder of the hit brand, Piper & Mint. an innovative pajama brand featured everywhere from the Drew Barrymore Show to QVC and helping combat the issue of night sweats for both postpartum and menopausal women. From 2017 to 2025 she was VP of merchandising, product development and design, then managing partner, at Atrium Apparel Corporation in Johnstown, Ohio. Earlier, she ran her own jewelry and design line, Jackie Valentine. She is based in Westerville, Ohio.", "excerpt": "Jackie Hutson is a Central Ohio entrepreneur and product and merchandising expert.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jackie-hutson-87a03214/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.thesourcinggals.com", "label": "thesourcinggals.com"}], "photo": "/_blob/bf644151000000000000000000001918", "initials": "JH", "tags": ["podcasting", "founders", "advisory"], "sortKey": "jackie hutson"}, {"id": 41, "name": "Jade Floyd", "bio": "Jade Floyd is Senior Vice President of Public Affairs at Bryson Gillette, with 20 years of experience advising C-suite leaders, philanthropies, investment firms and sports organizations. For nearly a decade she was VP of Communications at the Case Foundation and Revolution, a D.C. venture capital firm with more than $2.5 billion under management. Before that she spent five years at CLS Strategies, and she began her career in Texas politics. Her clients have been covered by The New York Times, CNBC, Bloomberg, The Wall Street Journal and Fortune, and have spoken at Fortune Most Powerful Women. She wrote \"The Leadership Labyrinth: Women Navigating Power and Purpose in a Changing World.\" She is an adjunct professor at George Washington University, where she teaches social impact communications, and she has moderated at SXSW and the Shorty Awards.", "excerpt": "Jade Floyd is Senior Vice President of Public Affairs at Bryson Gillette, with 20 years of experience advising C-suite leaders, philanthropies, investment firms and sports organizations.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jadefloyd/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://theleadershiplabyrinth.com", "label": "theleadershiplabyrinth.com"}], "photo": "/_blob/fe622f62000000000000000000001716", "initials": "JF", "tags": ["authors", "marketing", "advisory"], "sortKey": "jade floyd"}, {"id": 43, "name": "Jen Polt", "bio": "Jen Polt spent 25 years in corporate sales leadership before walking away at 52 to build something of her own—on social media, without a safety net. She’s now a confidence coach, content creator, and founder of The Confidence Clubhouse—a membership community helping women in midlife who feel lost rediscover their purpose and passions in their 2nd half. Jen’s messages of radical self love reach 750,000 people across her social platforms, encouraging women to become boldly, unapologetically, SELF centered.", "excerpt": "Jen Polt spent 25 years in corporate sales leadership before walking away at 52 to build something of her own—on social media, without a safety net.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jenniferpolt/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.glossedworld.com", "label": "glossedworld.com"}], "photo": "/_blob/af7800ad000000000000000000003740", "initials": "JP", "tags": ["founders", "advisory", "communities", "authors"], "sortKey": "jen polt"}, {"id": 44, "name": "Jennie Blumenthal", "bio": "I run Corporate Rehab Advisory, a boutique consulting firm helping enterprise commercial & PE-backed leaders redesign how they lead and how their teams operate in the Age of AI—so they can move faster, free up capacity, and unlock growth. Our work is a blend of workflow redesign, leadership development, and business results, built on my 25 years of experience in growth strategy and technology across the Fortune 500, and backed by a suite of AI agents and proprietary tools.", "excerpt": "I run Corporate Rehab Advisory, a boutique consulting firm helping enterprise commercial & PE-backed leaders redesign how they lead and how…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jennieblumenthal/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.corporate-rehab.com", "label": "corporate-rehab.com"}], "photo": "/_blob/9faf15319b4936941379a001b49f17ac", "initials": "JB", "tags": ["founders", "advisory"], "sortKey": "jennie blumenthal"}, {"id": 45, "name": "Jennifer Justice", "bio": "Jennifer Justice, aka JJ, is the Founder & CEO of The Justice Dept., a legal and business advisory firm built specifically for women tired of being undervalued, underestimated and underpaid. Prior thereto, she spent 17 years as Jay-Z's attorney, 6 of which were also as General Counsel and EVP of Roc Nation. She's brought that same dealmaking instinct to her own platform: as a negotiation strategist, attorney, podcast host of Takin' Care of Lady Business, a companion newsletter, and creator of the framework The Ask Filter, all built around helping women ask for, and get, what they're worth. She's a first-generation college graduate and a single mother by choice to boy-girl twins.", "excerpt": "Jennifer Justice, aka JJ, is the Founder & CEO of The Justice Dept., a legal and business advisory firm built specifically for women tired…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jennifer-justice-354a0b99/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.thejusticedept.com", "label": "thejusticedept.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/jenniferjusticel/", "label": "@jenniferjusticel"}], "photo": "/_blob/bf6ffc42000000000000000000002429", "initials": "JJ", "tags": ["founders", "podcasting", "newsletters", "advisory"], "sortKey": "jennifer justice"}, {"id": 46, "name": "Jenny Wood", "bio": "Jenny Wood is the New York Times bestselling author of WILD COURAGE: Go After What You Want and Get It. In her book—and sought-after keynotes—she reveals nine unconventional traits that power the world’s most resilient and high-performing people. A former Google executive and Harvard Business School researcher, Jenny spent 18 years rising from entry-level to COO roles across global divisions as the company scaled from 6,000 to 180,000 employees. She led hybrid, multi-generational teams across the Americas, Asia, and Europe, helping drive billions in annual revenue while navigating hypergrowth, layoffs, and reinvention. Jenny founded Own Your Career, one of the largest internal career programs in Google’s history. The program reached 56,000 employees in nearly 100 countries—and redefined how Googlers build influence and grow their careers from day one. Her 375+ pieces on those topics, with features in Harvard Business Review, CNBC, Forbes, Business Insider, Entrepreneur, and Inc. Her dynamic keynotes blend bold storytelling, practical strategy, and real-world tools to help teams break the mold and lead with courage, and impact—especially under pressure. F500 companies like SalesForce, Oracle, Target, Capital One, Royal Caribbean, State Farm, CVS, and Johnson & Johnson invite her back to speak again and again. Jenny’s a motivator, unstoppable confidence booster, and fierce advocate for unrealized potential. When she’s not on stage, she’s hiking, flying airplanes, singing in the kitchen, or chasing the perfect zucchini bread recipe.", "excerpt": "Jenny Wood is the New York Times bestselling author of WILD COURAGE: Go After What You Want and Get It.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jennyilles/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://itsjennywood.com", "label": "itsjennywood.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/itsjennywood", "label": "@itsjennywood"}], "photo": "/_blob/d44bceb18a4e95a85ba830c42c24602f", "initials": "JW", "tags": ["authors", "advisory"], "sortKey": "jenny wood"}, {"id": 47, "name": "Jess Weisz", "bio": "My ambition wanted me to be a corporate superstar. Bath time had other plans. After trying to collect all the gold stars, I realized the game is unwinnable. I now write and speak about the heaping pile of unrealistic expectations and help working parents figure out why they end the day feeling like a failure.", "excerpt": "My ambition wanted me to be a corporate superstar. Bath time had other plans.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jessicaweisz/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://rulebreaker.co/", "label": "rulebreaker.co"}, {"kind": "Instagram", "href": "https://www.instagram.com/rulebreakerjess/", "label": "@rulebreakerjess"}], "photo": "/_blob/79baf1d751b812c2c65353b670c6f3fa", "initials": "JW", "tags": ["authors"], "sortKey": "jess weisz"}, {"id": 48, "name": "Jessica Alpert", "bio": "Jessica Alpert is a producer and media entrepreneur. She spent eight years at WBUR, a Boston NPR affiliate working in news, and later as managing producer of podcasts leading the teams behind Modern Love: The Podcast (with The New York Times), Last Seen (with The Boston Globe), Circle Round, Endless Thread, and more.  In 2019, she co-founded Rococo Punch (acquired in 2023), an audio content creation company that specializes in premium audio storytelling with clients like AdWeek, Conde Nast, Morgan Stanley, PBS, Atlas Obscura, and more.  Rococo Punch’s award-winning original series include “Inconceivable Truth,” three seasons of “The Turning,” and “Welcome to Provincetown.”  She now consults on other podcasts and is working on her first book.", "excerpt": "Jessica Alpert is a producer and media entrepreneur. She spent eight years at WBUR, a Boston NPR affiliate working in news, and later as…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jessicaalpertsilber/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.jessicaalpert.com", "label": "jessicaalpert.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/jalpertsilber/", "label": "@jalpertsilber"}], "photo": "/_blob/729cc275740b888a66d52f3c191db11c", "initials": "JA", "tags": ["podcasting", "founders", "advisory"], "sortKey": "jessica alpert"}, {"id": 49, "name": "Jessica Turner", "bio": "Jessica N. Turner has spent the last two decades as a content creator and tastemaker for busy moms looking for hacks to live life with more intention and less stress. Additionally, Jessica is an award-winning content strategist and marketing professional. She speaks at events nationwide on a variety of topics including work-life balance, grief and disappointment, and social media best practices. She is also the author of the Wall Street Journal bestselling book The Fringe Hours: Making Time for You and Stretched Too Thin: How Working Moms Can Lose the Guilt, Work Smarter, and Thrive. She has been featured in numerous media outlets including the Today show, the Tamron Hall Show, O, the Oprah Magazine, People magazine, Better Homes & Gardens, Time.com, Inc.com, and more. Jessica lives with her three children in Nashville, Tennessee.", "excerpt": "Jessica N. Turner has spent the last two decades as a content creator and tastemaker for busy moms looking for hacks to live life with more intention and less stress.", "links": [{"kind": "Website", "href": "https://jessicanturner.com", "label": "jessicanturner.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/JessicaNTurner", "label": "@JessicaNTurner"}], "photo": "/_blob/cf655262000000000000000000001a19", "initials": "JT", "tags": ["newsletters", "authors", "marketing"], "sortKey": "jessica turner"}, {"id": 50, "name": "Jo Piazza", "bio": "Jo Piazza is the CEO of Influential Media, a bestselling author, podcast creator and digital strategy wizard.", "excerpt": "Jo Piazza is the CEO of Influential Media, a bestselling author, podcast creator and digital strategy wizard.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/jo-piazza-86223519/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.jopiazza.com", "label": "jopiazza.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/jopiazzaauthor/", "label": "@jopiazzaauthor"}], "photo": "/_blob/11ea952c169d9ebda837e6ed3ed88476", "initials": "JP", "tags": ["authors", "podcasting"], "sortKey": "jo piazza"}, {"id": 51, "name": "Kamber Crowe Schram", "bio": "Kamber Crowe is a strategy and operations leader and consultant who helps businesses turn ambitious ideas into clear, scalable systems and strategies. Her career spans program management, business transformation, go-to-market strategy, and client advisory, with a particular strength in bringing clarity to complex, fast-moving environments and aligning people around execution.", "excerpt": "Kamber Crowe is a strategy and operations leader and consultant who helps businesses turn ambitious ideas into clear, scalable systems and…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/kambercroweschram", "label": "LinkedIn"}], "photo": "/_blob/12557831117670c2e626185891b97a6a", "initials": "KS", "tags": ["advisory"], "sortKey": "kamber crowe schram"}, {"id": 52, "name": "Kanika Chadda-Gupta", "bio": "Kanika Chadda Gupta is a media mom of multiples - former CNN International journalist, award-winning podcast host, and creator of In Moderation™, a high-impact master class for media personalities on up-leveling their interview skills.\n\nHost of That’s Total Mom Sense, she’s interviewed Chelsea Clinton, Kelly Rowland, America Ferrera and other influential voices, and has been featured in Forbes, ABC, NBC, CBS and Fox. Named one of “100 Women to Know in America” by JPMorgan Chase and KNOW Women, she is the Official Podcast Partner and is a resident speaker for Reese Witherspoon's Hello Sunshine.", "excerpt": "Kanika Chadda Gupta is a media mom of multiples - former CNN International journalist, award-winning podcast host, and creator of In…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/kanika-chadda-gupta-28bb1911/", "label": "LinkedIn"}, {"kind": "Website", "href": "http://www.thatstotalmomsense.com", "label": "thatstotalmomsense.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/kanikachaddagupta/", "label": "@kanikachaddagupta"}], "photo": "/_blob/cf70fd43000000000000000000002530", "initials": "KC", "tags": ["podcasting", "journalism", "authors"], "sortKey": "kanika chadda-gupta"}, {"id": 53, "name": "Kate Doerge", "bio": "Kate Doerge is a USA TODAY bestselling author, motivational speaker, certified grief coach, brand strategist, and nonprofit founder whose work focuses on helping people navigate life’s challenges, adversity, change, and loss with resilience, connection, and purpose. Following the unimaginable loss of her 16-year-old daughter, Penny, in 2022, Kate chose to turn her pain into purpose, co-founding Penny’s Flight Foundation to honor Penny’s life and raise awareness and funding for Neurofibromatosis (NF), the genetic disorder Penny lived with. What began as a mission to honor one extraordinary girl has grown into a national movement, inspiring communities to create meaningful change. Kate is the author of Reimagining Grief: A New Path to Finding Healing, Strength and Joy After Loss (Hay House), with a foreword by Jenna Bush Hager. Kate’s work explores resilience through adversity, navigating change and uncertainty, protecting our energy, the power of connection, and finding purpose and possibility when life doesn’t go according to plan. With a background in brand strategy, leadership, and philanthropy, Kate brings a unique perspective to conversations about personal and professional growth, emphasizing that while we cannot always control the circumstances we face, we can choose how we respond and the impact we make.", "excerpt": "Kate Doerge is a USA TODAY bestselling author, motivational speaker, certified grief coach, brand strategist, and nonprofit founder whose work focuses on…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/kate-doerge/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.katedoerge.com", "label": "katedoerge.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/doergek", "label": "@doergek"}], "photo": "/_blob/f01ea38c40b18c7b7975e707b19642c6", "initials": "KD", "tags": ["founders", "authors", "advisory"], "sortKey": "kate doerge"}, {"id": 54, "name": "Katherine Goldstein", "bio": "Katherine Goldstein is a journalist, speaker, and consultant. A  Better Life Lab at New America fellow and former Nieman Journalism Fellow at Harvard, her writing has appeared in the New York Times, Washington Post, The Guardian, Vox, and NPR.\n\nHer book, Neighboring: How to Build Community You Can Count On (Penguin Random House), comes out April 6th, 2027. It draws on nearly a hundred interviews and years of research to propose deeply practical solutions for how to rebuild our connections skills and strengthen our relationships in neighborhoods, family life, houses of worship, workplaces and more.", "excerpt": "Katherine Goldstein is a journalist, speaker, and consultant. A Better Life Lab at New America fellow and former Nieman Journalism Fellow…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/katherine-goldstein/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://katherinegoldstein.com", "label": "katherinegoldstein.com"}], "photo": "/_blob/b4caa39643a660234fd69325d7e4703b", "initials": "KG", "tags": ["journalism", "authors", "advisory"], "sortKey": "katherine goldstein"}, {"id": 55, "name": "Kathryn Valentine", "bio": "Kathryn Valentine is a nationally recognized expert on how women advance their careers.  A top-rated speaker, her clients include JPMorgan, KPMG, and Bain, and her TEDx talk on women and negotiation reached #1 on TED.com. Her work has been featured in Harvard Business Review, The Wall Street Journal, and Fast Company. Kathryn started her career at McKinsey & Company and now lives in Atlanta with her husband and two active sons, who keep her negotiation skills sharp and her coffee consumption high.", "excerpt": "Kathryn Valentine is a nationally recognized expert on how women advance their careers.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/kval/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://worthmorestrategies.com/", "label": "worthmorestrategies.com"}], "photo": "/_blob/cc2c1b10c7a9bfd8f9e24731b8ede92b", "initials": "KV", "tags": ["authors"], "sortKey": "kathryn valentine"}, {"id": 56, "name": "Katie Fogarty", "bio": "Katie Fogarty is the host and producer of A Certain Age, a top 1% global podcast featuring expert-backed conversations on midlife health, hormones, career, and identity. A former journalist, she’s the founder of The Reboot Group, which offers coaching on career and brand storytelling for leaders at companies like Google, Meta, and American Express. A frequent media expert on career reinvention, midlife and women's leadership, Katie serves on the board of Let's Talk Menopause.", "excerpt": "Katie Fogarty is the host and producer of A Certain Age, a top 1% global podcast featuring expert-backed conversations on midlife health…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/katiefogartymedia/?isSelfProfile=true", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.acertainagepod.com/", "label": "acertainagepod.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/acertainagepod/", "label": "@acertainagepod"}], "photo": "/_blob/4f5e1efe388260613933e26947be0885", "initials": "KF", "tags": ["podcasting", "founders", "advisory"], "sortKey": "katie fogarty"}, {"id": 57, "name": "Katie Harbath", "bio": "Katie Harbath is the founder of Anchor Change, a consultancy advising companies, civil society organizations, and policymakers on issues related to technology and democracy. Katie’s first book, Disrupting Politics, was released by Simon & Schuster in October. A Green Bay, Wisconsin native, she writes the Anchor Change newsletter, read by thousands of leaders and policymakers worldwide, and is a regular voice on elections, AI, and platform accountability. She previously spent a decade as director of public policy for global elections at Facebook. She regularly serves as a fellow at institutions such as the Bipartisan Policy Center, the Integrity Institute, and the Atlantic Council. Harbath is recognized as a thought leader and public speaker on topics relating to digital strategy, election security, misinformation, and the future of online civic engagement. Her philosophy: panic responsibly—take the risks seriously without letting fear paralyze the work.", "excerpt": "Katie Harbath is the founder of Anchor Change, a consultancy advising companies, civil society organizations, and policymakers on issues related to technology and democracy.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/harbath/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://anchorchange.com/about", "label": "anchorchange.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/katieharbath", "label": "@katieharbath"}], "photo": "/_blob/444743772904d4ff76ea515030d9f3b0", "initials": "KH", "tags": ["newsletters", "founders", "authors", "advisory"], "sortKey": "katie harbath"}, {"id": 58, "name": "Kendall Cherry", "bio": "Hey there! I'm Kendall Cherry and I'm a storytelling + sales writing extraordinaire. I specialize in writing editorial essays and premium sales assets for my clients—as well as helping YOU develop your signature book to unlock your next era of epic opportunities. My debut book, Here to Sell, is also publishing on November 10th. This project was self-funded, self-produced, and self-published, so if you've got any questions about what the IP and creative development process looked like for me, I'm an open book! (Pun intended.)", "excerpt": "Hey there! I'm Kendall Cherry and I'm a storytelling + sales writing extraordinaire.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/kendall-cherry/?isSelfProfile=true", "label": "LinkedIn"}, {"kind": "Website", "href": "https://kendallcherry.com", "label": "kendallcherry.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/kendallcherrywrites/", "label": "@kendallcherrywrites"}], "photo": "/_blob/26d9883f9536597b20ea3e0dfae6f474", "initials": "KC", "tags": ["authors", "marketing"], "sortKey": "kendall cherry"}, {"id": 59, "name": "Kristen Coffield", "bio": "Kristen is the founder of the Active Grandparenting™ movement and The Culinary Cure, she's a thought leader in modern grandparenting and purposeful aging. TEDx speaker, coach, and influencer, she empowers women in life’s third act to energize their lives, live intentionally, and grandparent with impact. Active Grandparenting™ is her new book!", "excerpt": "Kristen is the founder of the Active Grandparenting™ movement and The Culinary Cure, she's a thought leader in modern grandparenting and…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/kristen-coffield-liveyounger/details/experience/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.activegrandparenting.com", "label": "activegrandparenting.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/kristencoffield/", "label": "@kristencoffield"}], "photo": "/_blob/ba7592fa0f5ef3c75ff9463bcb5645c9", "initials": "KC", "tags": ["founders", "authors", "advisory"], "sortKey": "kristen coffield"}, {"id": 60, "name": "Kristen Rocco", "bio": "Kristen Rocco is a story strategist, content marketing expert, speaker, and founder of the Bold Moves platform. Bridging corporate strategy with human storytelling, she’s led triple-digit content growth from her office desk and built a top 10% podcast from her kitchen table. Today, Kristen partners with brands to build and spread bold ideas through strategic storytelling and thought leadership, and leads masterminds and workshops that empower women to make bold moves to design a career and life that lights them up.\nOver a 15-year career in content marketing, Kristen has planned, produced, and shared stories across earned, owned, and paid channels. Previously, she led global content strategy at Fortune 500 tech company Global Payments, launching its flagship digital publication and marquee annual content campaigns. A finalist in the 2022 Women in Content Marketing Awards, she holds a Master’s degree in Integrated Communications from the University of South Carolina.\nThrough her globally ranked podcast Bold Moves: How Did You Know? and proprietary Bold Moves Method, Kristen deconstructs the psychology and process of making bold moves. She helps women get honest about what they actually want and break through the barriers holding them back to discover their Midlife Click—so they can confidently take that first step toward their next bold move.", "excerpt": "Kristen Rocco is a story strategist, content marketing expert, speaker, and founder of the Bold Moves platform.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/kristenrocco/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://kristenrocco.com", "label": "kristenrocco.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/kristenrocco/", "label": "@kristenrocco"}], "photo": "/_blob/b79414bc1769b77ffa907b6d8193fdab", "initials": "KR", "tags": ["marketing", "podcasting", "founders", "authors"], "sortKey": "kristen rocco"}, {"id": 61, "name": "Kristin Graham", "bio": "Hello, future friends! I’m a brain-science-meets-word-nerd entrepreneur, speaker, and podcaster who’s deeply curious about why humans do what we do. After two decades of doing words and people inside big global companies, I founded Unlock the Brain. Today, my work blends neuroscience, behavioral psychology, and everyday habits to help smart, overwhelmed people do fewer things better.\n\nCome find me if you want to talk about your dog (mine is Lucy), being a non-coffee drinker in Seattle, my former-journalist devotion to the Oxford comma, being weirdly good at the NYT Mini, or my inability to break up with Dr Pepper.", "excerpt": "Hello, future friends! I’m a brain-science-meets-word-nerd entrepreneur, speaker, and podcaster who’s deeply curious about why humans do…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/kristingraham1", "label": "LinkedIn"}, {"kind": "Website", "href": "https://unlockthebrain.com/", "label": "unlockthebrain.com"}], "photo": "/_blob/df71fe44000000000000000000002631", "initials": "KG", "tags": ["founders", "podcasting", "authors"], "sortKey": "kristin graham"}, {"id": 62, "name": "Kristina Flynn", "bio": "kristina (with a 'k') flynn is an Overthinking High-Achiever (OHA) helping other OHAs turn their wild careers and stories into personal brands that feel like them and make sh*ttons of money.\nFor 18+ years and across 11 roles in 8 industries, she's built brands for NBA All-Stars, Olympians, venture capitalists, Youtubers, founders, and executives. The through-line across all of it: wildly capable people who are great at seeing other people's value, but can't see their own.\nIn 2023 - after realizing she didn't know who the f*ck she was - she built StoryEQ™ to close the gap. Now her personal brand studio and the methodology behind it, StoryEQ™, combines interview-based pattern recognition, neuroscience, and AI-driven self-reflection to surface the through-lines hiding in someone's story. The stuff your brain filters out because you've lived it so long it's invisible. And the stuff your positioning, your offers, and your brand are built on, but missing.\n\nkristina's first loves were basketball and hip-hop. And she lives in Toronto, Canada with her wife, two young kids, and stubborn Frenchie, Lady Edith Windsor.", "excerpt": "kristina (with a 'k') flynn is an Overthinking High-Achiever (OHA) helping other OHAs turn their wild careers and stories into personal…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/flynnkristina", "label": "LinkedIn"}, {"kind": "Website", "href": "https://storyeq.com", "label": "storyeq.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/flynnkristina/", "label": "@flynnkristina"}], "photo": "/_blob/037ff9d7a66e13805166f0d611e07654", "initials": "KF", "tags": ["founders", "marketing"], "sortKey": "kristina flynn"}, {"id": 63, "name": "Laura Brounstein", "bio": "Laura Brounstein is an award-winning journalist, podcaster, and communications strategist. She co-hosts Across the Bar, a weekly podcast and newsletter on politics, pop culture, and workplace power, and is a regular political commentator on NewsNation. Through LB & Partners, she advises brands, campaigns, and C-suite leaders on editorial and content strategy, events and community, and communications. She served as Spokesperson for Consumer and Women's Media on the Harris-Walz campaign and ran a digital surrogate program on the Biden/Harris 2020 team. A former top editor at Cosmopolitan, Seventeen, and SELF, her work has won a National Magazine Award, a GLAAD Media Award, and a Deadline Club Award. She serves on the board of Jewish On Campus and lives in NYC.", "excerpt": "Laura Brounstein is an award-winning journalist, podcaster, and communications strategist.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/laurabrounstein/", "label": "LinkedIn"}, {"kind": "Instagram", "href": "https://www.instagram.com/laurabrounstein/", "label": "@laurabrounstein"}], "photo": "/_blob/1ac7c9a38d0f10e132a583bb288792b3", "initials": "LB", "tags": ["journalism", "podcasting", "newsletters", "advisory"], "sortKey": "laura brounstein"}, {"id": 64, "name": "Laura Rowley", "bio": "Laura Rowley grew up with ten siblings in an Irish-American family, where the best way to win the room was to tell a good tale. She is the author of seven non-fiction books and a novel, and is a Director at SitusAMC, a tech and services firm with 4,000 professionals in 28 global offices, serving the largest financial institutions in real estate finance. An award-winning journalist, Laura held editorial and executive roles at CNN, The Huffington Post, Yahoo!Finance, and People Inc. Her writing has been featured in The New York Times, Gannett, Parents, Self and other outlets, and she has appeared on The Today Show, Good Morning America, CBS, CNBC, NPR and other media. She has three daughters. Learn more at laurarowley.com.", "excerpt": "Laura Rowley grew up with ten siblings in an Irish-American family, where the best way to win the room was to tell a good tale.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/laura-rowley-writer/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://laurarowley.com", "label": "laurarowley.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/laurarowleyny/", "label": "@laurarowleyny"}], "photo": "/_blob/21b33e1e2d841322a115643acebd00cd", "initials": "LR", "tags": ["authors", "journalism"], "sortKey": "laura rowley"}, {"id": 65, "name": "Leah Fink", "bio": "Leah Wiseman Fink is a Brooklyn-based coach, community builder, and entrepreneur. She’s the founder of The Spark Society, a curated community for ambitious women in NYC, and co-owner of Williamsburg Pizza. A former educator, Leah now coaches women through what’s next in their work and lives, and writes Party Cut, her weekly newsletter about work, friendship, community, and everything in between.", "excerpt": "Leah Wiseman Fink is a Brooklyn-based coach, community builder, and entrepreneur.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/leahwisemanfink/", "label": "LinkedIn"}, {"kind": "Instagram", "href": "https://www.instagram.com/leahwisemanfink/", "label": "@leahwisemanfink"}], "photo": "/_blob/9e67a9ce93e991ad66103c8eef6d0003", "initials": "LF", "tags": ["communities", "founders", "newsletters", "advisory"], "sortKey": "leah fink"}, {"id": 67, "name": "Lexi Grant", "bio": "Lexi runs They Got Acquired, which shares stories of founders who've sold their business and how they did it. She has built and sold several niche media brands. Lexi lives with her husband and two boys, and she loves to hike and practice yoga. She's happy to answer any questions about how to build a business you can sell!", "excerpt": "Lexi runs They Got Acquired, which shares stories of founders who've sold their business and how they did it.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/alexisgrant/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://TheyGotAcquired.com", "label": "theygotacquired.com"}], "photo": "/_blob/ef72ff45000000000000000000002732", "initials": "LG", "tags": ["founders", "newsletters"], "sortKey": "lexi grant"}, {"id": 68, "name": "Liz Kelly Nelson", "bio": "Liz Kelly Nelson is a leader in journalism innovation, dedicated to helping independent journalists and media creators build sustainable careers in a rapidly evolving media landscape. With a background in newsroom leadership, digital media strategy and creator economy expertise, Liz has worked across the journalism ecosystem — supporting reporters and journalism creators across mediums, advising media startups and collaborating with major institutions on the future of independent journalism. As the founder of Project C, a concept she developed during her 2024 Sulzberger Fellowship at Columbia University’s Graduate School of journalism, she is focused on empowering journalists to embrace new models, find sustainable revenue and create impactful work outside of traditional media structures. Prior to Project C, Liz led teams at Vox, USA Today, Gannett and AOL.", "excerpt": "Liz Kelly Nelson is a leader in journalism innovation, dedicated to helping independent journalists and media creators build sustainable careers in a rapidly evolving media landscape.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/lizkellynelson/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://newsletter.projectc.biz", "label": "newsletter.projectc.biz"}], "photo": "/_blob/af633040000000000000000000001817", "initials": "LN", "tags": ["founders", "journalism", "advisory"], "sortKey": "liz kelly nelson"}, {"id": 69, "name": "Lori Keim", "bio": "I spent 22 years as a women's healthcare executive in a highly complex political environment while co-founding a restaurant in San Diego 14 years ago that continues to grow today. I just launched LK Advisory where I bring that experience to women founders who have already built something real, are ready to grow, and are done being the one holding it up. I'm not a coach, I'm an advisor. And the women I work with tell me... \"I just wish someone told me what the f*ck to do.\" I've built and run the complex operation twice and will tell you exactly what to fix first. I've lived in San Diego for 26 years with my partner Dennis and sweet pup named Hemingway. I love traveling the world, reading and engaging with vibrant humans.", "excerpt": "I spent 22 years as a women's healthcare executive in a highly complex political environment while co-founding a restaurant in San Diego 14 years ago that continues to grow today.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/lori-keim/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.lorikeim.com", "label": "lorikeim.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/lkadviseswomenbusinesses", "label": "@lkadviseswomenbusinesses"}], "photo": "/_blob/9aa7349b34d473b4042095047633993e", "initials": "LK", "tags": ["founders", "advisory"], "sortKey": "lori keim"}, {"id": 70, "name": "Lori Mihalich-Levin", "bio": "Lori Mihalich-Levin, JD, is the founder and CEO of Mindful Return, author of Back to Work After Baby: How to Plan and Navigate a Mindful Return from Maternity Leave, and co-host of the Parents at Work Podcast. 100+ employers are proud to offer her award-winning return-to-work programs to their new parent colleagues as a parental leave benefit. Lori is mama to two wonderful red-headed boys (ages 13 and 15) and is a health care lawyer in private practice. Her thought leadership has been featured on dozens of podcasts and in publications including Forbes, The Washington Post, New York Times Parenting, and Thrive Global.", "excerpt": "Lori Mihalich-Levin, JD, is the founder and CEO of Mindful Return, author of Back to Work After Baby, and co-host of the Parents at Work Podcast.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/lorimihalichlevin/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.mindfulreturn.com", "label": "mindfulreturn.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/mindfulreturn", "label": "@mindfulreturn"}], "photo": "/_blob/27e09dffccb64c1cf0d96b29734df9ec", "initials": "LL", "tags": ["podcasting", "founders", "authors", "advisory"], "sortKey": "lori mihalich-levin"}, {"id": 71, "name": "Maureen Wiley Clough", "bio": "Maureen Wiley Clough is a former journalist who later climbed the corporate tech ladder, until someone at work called her a \"dinosaur\" at 37. She was laid off from her brand new job - in a layoff of one - at a different tech company a couple years later. The plot twist: she'd just launched her podcast, It Gets Late Early, about all the issues facing mid-career workers (including ageism) one month earlier, so she basically documented her own ending before it happened.\n\nMaureen turned getting pushed out of corporate into a whole new career. She's now an independent media founder with a platform of more than 110K people across social media as well as a speaker, moderator, and brand partner. A LinkedIn Top Voice, she’s been featured in Forbes, WIRED, and Business Insider, and she partners with AARP, Hubspot, and other forward-thinking organizations. It Gets Late Early is a top 1.5% podcast globally and has reached #13 on Apple Careers US. Her whole world is about helping people build something resilient in corporate or start something else of their own so they never have to depend on any one company saying yes to them again.", "excerpt": "Maureen Wiley Clough is a former journalist who later climbed the corporate tech ladder, until someone at work called her a \"dinosaur\" at…", "links": [{"kind": "LinkedIn", "href": "https://linkedin.com/in/maureenwclough", "label": "LinkedIn"}, {"kind": "Website", "href": "https://itgetslateearly.com", "label": "itgetslateearly.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/maureenwclough/", "label": "@maureenwclough"}], "photo": "/_blob/73f52080c1ef56700a5e2fbe152a2afa", "initials": "MC", "tags": ["podcasting", "founders", "authors"], "sortKey": "maureen wiley clough"}, {"id": 72, "name": "Meggie Palmer", "bio": "I help women get wealthy!\nI’m an Exec Coach, speaker & founder of PepTalkHer which is on a mission to close the gender pay gap.\nI run a mastermind for high earning professional women seeking likeminded community, a calm nervous system & a financial pathway to early retirement.\nI’m a former foreign correspondent for the BBC, CNBC & a former VP at the Financial Times.\nMom to Hugo, aussie living in New York! (Carroll Gardens Brooklyn, to be specific) 🤗", "excerpt": "I help women get wealthy! I’m an Exec Coach, speaker & founder of PepTalkHer, on a mission to close the gender pay gap.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/meggiepalmer", "label": "LinkedIn"}, {"kind": "Website", "href": "https://peptalkher.com", "label": "peptalkher.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/meggiepalmer", "label": "@meggiepalmer"}], "photo": "/_blob/3a9f7c2a3ba0d011279f9b63783f12d4", "initials": "MP", "tags": ["founders", "authors", "advisory"], "sortKey": "meggie palmer"}, {"id": 73, "name": "Melanie Mannarino", "bio": "Melanie Mannarino is an award-winning journalist, editorial brand strategist, and author. As the founder of MM Creative LLC, she partners with mission-aligned brands to shape messaging, build trust, and drive audience engagement across platforms. As content editor for the UnPaused podcast, she helps guide the narrative direction of each episode. A sought-after speaker and the author of four books—including The (Almost) Zero-Waste Guide—Melanie also advises entrepreneurs and advocates on how to write and publish their own stories.", "excerpt": "Melanie Mannarino is an award-winning journalist, editorial brand strategist, and author.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/melanie-mannarino/", "label": "LinkedIn"}], "photo": "/_blob/98a081facb867a00418166b857811327", "initials": "MM", "tags": ["journalism", "authors", "marketing", "advisory"], "sortKey": "melanie mannarino"}, {"id": 74, "name": "Molly Angel", "bio": "I'm a change management consultant, specializing in the human aspect of transition in highly regulated industries. Think aviation, healthcare, public utilities - everywhere that there is government oversight of data within an organization. I focus on the people part of the process change - communication and training. With a health dose of leadership engagement to build better change leadership. I also teach at the University of Washington's MHA program (Transformation Mgt) and Portland State University (Change Management).", "excerpt": "I'm a change management consultant, specializing in the human aspect of transition in highly regulated industries.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/mollyangel/", "label": "LinkedIn"}], "photo": "/_blob/554700706b7b94485a2154a29cd29927", "initials": "MA", "tags": ["advisory"], "sortKey": "molly angel"}, {"id": 76, "name": "Nobar E. Golhar", "bio": "Nobar Elmi Golhar is the Founder and CEO of Golmi Partners, a Washington, DC-based corporate affairs and communications firm. With more than 20 years of experience across the private, public, and nonprofit sectors, Nobar specializes in strategic messaging, stakeholder engagement, and communications that help organizations make complex issues clear, relevant, and actionable.\n\nHer career has included roles at prominent public affairs firms, a global corporate advisory firm, a national advocacy organization, and a state government agency. Today, she brings that cross-sector experience to her clients as a strategic partner, combining communications expertise with empathy, curiosity, and a practical, solutions-oriented approach.\n\nNobar is also the author of Nobar’s Notes, a LinkedIn newsletter offering practical tips to strengthen how people communicate and connect. And she is the founder of Our 6 Degrees, a curated membership community for executive women designed to foster meaningful relationships, candid conversation, and connection beyond traditional networking.", "excerpt": "Nobar Elmi Golhar is the Founder and CEO of Golmi Partners, a Washington, DC-based corporate affairs and communications firm.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/nobar-elmi-golhar", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.OurSixDegrees.com", "label": "oursixdegrees.com"}], "photo": "/_blob/a3ca7793d22a1ef108591e3fd5e73a31", "initials": "NG", "tags": ["founders", "communities", "newsletters", "advisory"], "sortKey": "nobar e. golhar"}, {"id": 77, "name": "Preeya Goenka", "bio": "I'm the Chief Customer Officer at beehiiv, an email newsletter platform, where I've spent the last 4 years. I work closely with content creators, media companies and newsletter operators, helping them with their growth and monetization strategy. Prior to that, I spent 6 years at Campaign Monitor & Sailthru, working in enterprise email.", "excerpt": "I'm the Chief Customer Officer at beehiiv, an email newsletter platform, where I've spent the last 4 years.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/preeya-goenka/", "label": "LinkedIn"}], "photo": "/_blob/1f19604573b3722df98c4b7fad8f6044", "initials": "PG", "tags": ["newsletters"], "sortKey": "preeya goenka"}, {"id": 78, "name": "Quinn Daly", "bio": "Quinn is the founder of Daly Strategies, a communications firm built to serve organizations and teams of integrity with smart creativity and hustle. Quinn’s work in messaging, thought leadership and strategic planning help her clients grow and reach their target audiences. She is a long-term thought leader partner with AARP. Quinn previously worked in executive roles with brands including LaForce, Coburn Communications, and Demand media.", "excerpt": "Quinn is the founder of Daly Strategies, a communications firm built to serve organizations and teams of integrity with smart creativity and hustle.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/quinndaly/", "label": "LinkedIn"}], "photo": "/_blob/ef677484000000000000000000001c21", "initials": "QD", "tags": ["founders", "marketing", "advisory"], "sortKey": "quinn daly"}, {"id": 79, "name": "Rachel Lipson", "bio": "Rachel Lipson is the founder of The Point, a top 40 travel newsletter on Substack about using points and miles for elevated travel with kids in tow. Her work has been featured in The New York Times, Condé Nast Traveler, New York Magazine and more. Rachel is also the founder and CEO of Blue Balloon Songwriting School, a music education company that specializes in 1:1 in-home music lessons for kids 3 and up in NYC, The Hamptons, Nashville and a handful of other cities.", "excerpt": "Rachel Lipson is the founder of The Point, a top 40 travel newsletter on Substack about using points and miles for elevated travel with…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/rlipson/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://thepointedit.com", "label": "thepointedit.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/thepoint.edit/", "label": "@thepoint.edit"}], "photo": "/_blob/7ce30034637ff106790c0821a9532bea", "initials": "RL", "tags": ["newsletters", "founders"], "sortKey": "rachel lipson"}, {"id": 80, "name": "Randi Braun", "bio": "Randi Braun is the Wall Street Journal best-selling author of \"Something Major: The New Playbook for Women at Work\" & CEO of the women's leadership firm, Something Major. An expert at helping high-performing women crush it at work without being crushed in the process, Randi is a sought-after coach and keynote speaker who has been featured by Forbes, CNBC, Parents & The Washington Post, among others. She is also the author of a forthcoming book on working motherhood with Sourcebooks (arriving winter 2028).", "excerpt": "Randi Braun is the Wall Street Journal best-selling author of \"Something Major: The New Playbook for Women at Work\" & CEO of the women's…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/randi-braun-312a5423/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.somethingmajorcoaching.com/", "label": "somethingmajorcoaching.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/something_major_coaching/", "label": "@something_major_coaching"}], "photo": "/_blob/7d84aaf22c976b3e35e42d35ab48e206", "initials": "RB", "tags": ["authors", "founders", "advisory"], "sortKey": "randi braun"}, {"id": 81, "name": "Rina Shah", "bio": "Geopolitical adviser, strategist, and six-time entrepreneur. Rina is CEO of Rilax Strategies and has served as chief spokesperson on two U.S. presidential campaigns and as a senior aide to two members of Congress. A West Virginia native and daughter of immigrants forced out of Uganda, she advises founders, elected officials, and diplomats on geopolitical risk, communications, and leadership in a more volatile world. She is a frequent commentator on CNN, MSNBC, CBS, BBC, and C-SPAN.", "excerpt": "Geopolitical adviser, strategist, and six-time entrepreneur. Rina is CEO of Rilax Strategies and has served as chief spokesperson on two…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/rinaindc", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.runwithrina.com", "label": "runwithrina.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/RinainDC/", "label": "@RinainDC"}], "photo": "/_blob/bf740147000000000000000000002934", "initials": "RS", "tags": ["founders", "advisory"], "sortKey": "rina shah"}, {"id": 82, "name": "Ruthie Ackerman", "bio": "Ruthie Ackerman is the author of The Mother Code: My Story of Love, Loss, and the Myths That Shape Us, named one of Elle's Best Books of the Year and a Best Nonfiction Book of the Year So Far by NPR. Her work has appeared in Vogue, Glamour, Oprah Daily, The New York Times, The Atlantic, The Wall Street Journal, and more, and she was most recently the deputy editor of ForbesWomen. When she's not writing her own books, she's helping others write theirs. As founder of the Ignite Writers Collective, Ruthie is a book coach and developmental editor who has worked with hundreds of writers at every stage — from the seed of an idea to a polished proposal or manuscript to a launch strategy in the months before publication. Her clients' wins include bestselling books, multi-six-figure deals with Big 5 publishers, and representation by top-tier agents. She holds a Master's in Journalism from New York University and lives in Brooklyn with her family.", "excerpt": "Ruthie Ackerman is the author of The Mother Code: My Story of Love, Loss, and the Myths That Shape Us, named one of Elle's Best Books of…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/ruthieackerman/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.ruthieackerman.com/", "label": "ruthieackerman.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/ruackerman/", "label": "@ruackerman"}], "photo": "/_blob/9ea485ad8761670e30cce7812b1fe353", "initials": "RA", "tags": ["authors", "journalism", "founders", "advisory"], "sortKey": "ruthie ackerman"}, {"id": 83, "name": "Sabrina Fonfeder", "bio": "Sabrina Fonfeder is a podcast producer and founder of Something Went Bump, a one stop shop for all podcast production, strategy, distribution needs. She began her career in TV, producing for Wendy Williams, Amy Schumer, Tim Robinson, among others, and pivoted into the booming audio industry nearly a decade ago.", "excerpt": "Sabrina Fonfeder is a podcast producer and founder of Something Went Bump, a one stop shop for all podcast production, strategy…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/sabrina-f-633b4a39/", "label": "LinkedIn"}], "photo": "/_blob/f1e658dc3a8df5a4ee9501d3e5afe623", "initials": "SF", "tags": ["podcasting", "founders"], "sortKey": "sabrina fonfeder"}, {"id": 84, "name": "Samantha Ettus", "bio": "Samantha Ettus is a bestselling author, media personality, motivational speaker, and content creator. She writes The Jewsletter, a Substack newsletter covering Israel and antisemitism. Sam co-hosted the award-winning iHeart podcast What's Her Story With Sam & Amy with Amy Nelson, and she reaches more than six million people across her social media channels each month. A two-time Harvard graduate, Sam is now writing her sixth self-help book.", "excerpt": "Samantha Ettus is a bestselling author, media personality, motivational speaker, and content creator.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/samanthaettus/", "label": "LinkedIn"}, {"kind": "Instagram", "href": "https://www.instagram.com/samanthaettus/", "label": "@samanthaettus"}], "photo": "/_blob/df760349000000000000000000003136", "initials": "SE", "tags": ["authors", "newsletters", "podcasting"], "sortKey": "samantha ettus"}, {"id": 85, "name": "Sara Michael", "bio": "Sara Michael is Executive Vice President of Content for MyHealthTeam, a Swoop company, where she oversees the unified content org. She also serves as Editor-in-Chief for ThisIsMenopause, a free online community for women navigating perimenopause and menopause.\n\nSara was previously Senior Vice President & Group General Manager, Health at People Inc (formerly Dotdash Meredith), where she was responsible for the editorial and business strategy of Verywell Health, Verywell Mind, and Health.com. Before joining DDM, Sara led content integrity initiatives at Healthline Media. Prior, she spent 10 years in the B2B health space, overseeing a portfolio of print and digital publications for healthcare providers, as well as held positions as editor, freelance writer, and reporter.\nSara received a master’s in journalism from Medill School of Journalism at Northwestern University, and just completed her master’s of business administration at Loyola University.", "excerpt": "Sara Michael is Executive Vice President of Content for MyHealthTeam, a Swoop company, where she oversees the unified content org.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/saramichael/", "label": "LinkedIn"}], "photo": "/_blob/428e9a0430f3c6dd0f3d4bbe9a60e2d9", "initials": "SM", "tags": ["journalism", "newsletters"], "sortKey": "sara michael"}, {"id": 86, "name": "Sarah K Peck", "bio": "Sarah K Peck is the founder of Startup Parent and the host of The Startup Parent Podcast, an award-winning podcast featuring women in entrepreneurship, business, and parenting. She runs The Wise Women's Council, a community mastermind for women navigating ambition, work, and midlife. She writes about work, culture, and parenting, and her work has been featured in Forbes, Inc, Fast Company, The New York Times, Harvard Business Review, and more. Join her newsletter, How To Be Human, on Substack.", "excerpt": "Sarah K Peck is the founder of Startup Parent and the host of The Startup Parent Podcast, an award-winning podcast featuring women in…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/sarahkpeck/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://wisewomenscouncil.com", "label": "wisewomenscouncil.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/sarahkpeck/", "label": "@sarahkpeck"}], "photo": "/_blob/ac45105212c179fd57bed820e0df3077", "initials": "SP", "tags": ["founders", "podcasting", "communities", "newsletters"], "sortKey": "sarah k peck"}, {"id": 87, "name": "Shannen Sharpe", "bio": "I spent my broadcast journalism career at WTVC NewsChannel 9 in Chattanooga, WAGA FOX 5 Atlanta, and Scripps News. I now run marketing for Litson, a Tennessee law firm, where I produce TARGET, a podcast and Substack about what it’s like to be the target of a federal investigation. I live in Atlanta.", "excerpt": "I spent my broadcast journalism career at WTVC NewsChannel 9 in Chattanooga, WAGA FOX 5 Atlanta, and Scripps News.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/shannensharpe", "label": "LinkedIn"}], "photo": "/_blob/64c2d60471e5e2b2edac07f489703d07", "initials": "SS", "tags": ["journalism", "marketing", "podcasting", "newsletters"], "sortKey": "shannen sharpe"}, {"id": 88, "name": "Shelli Spence", "bio": "Former mortgage operations executive (29 years, last seat Chief Credit Officer) who rebuilt her career from scratch. Now I teach executives how to build a LinkedIn presence that creates options before they need them.", "excerpt": "Former mortgage operations executive (29 years, last seat Chief Credit Officer) who rebuilt her career from scratch.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/shellikspence/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.shellionsocial.com", "label": "shellionsocial.com"}], "photo": "/_blob/3178f86649835681305c62a359b934ef", "initials": "SS", "tags": ["advisory"], "sortKey": "shelli spence"}, {"id": 89, "name": "Shoshanna Hecht", "bio": "Shoshanna Hecht is an executive and leadership coach, speaker, facilitator, and host of the podcast This Changes Things, the next chapter of her three-season show Your New Life Blend. Her work sits where the inner world meets the relational one: how leaders show up for themselves, and then for everyone around them. Based in New York City and working globally, she partners with individual leaders, leadership pairs such as co-founders and bosses with their direct reports, and teams. She helps them communicate, navigate complex dynamics, and lead with clarity and impact, at work and beyond. Shoshanna brings more than 15 years of coaching experience and a decade as a licensed clinical therapist, including specialized training in couples work, which lets her see what's happening inside a person and between people at the same time. Her thinking on leadership and relationships has been featured in Fast Company, Forbes, Vox, HuffPost, Time, The Guardian, and Business Insider, as well as in numerous leadership books.", "excerpt": "Shoshanna Hecht is an executive and leadership coach, speaker, facilitator, and host of the podcast This Changes Things, the next chapter…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/shoshannahecht/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://shoshannahecht.com", "label": "shoshannahecht.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/shoshannahecht/", "label": "@shoshannahecht"}], "photo": "/_blob/1d9313cbc5b66294748b0c59819c2945", "initials": "SH", "tags": ["advisory", "podcasting", "authors"], "sortKey": "shoshanna hecht"}, {"id": 90, "name": "Susannah Ludwig", "bio": "Susannah Ludwig is a life coach who helps people navigate change with clarity, purpose and imagination. She works with clients facing major transitions, everyday crossroads and the question of what comes next.\n\nBorn with serious health challenges, Susannah knows that difficult experiences can deepen our understanding of ourselves and open new possibilities. Her coaching helps clients make room for what is hard, the meaning in the muck, while identifying the beauty, intention and direction ahead.\n\nSusannah is also a producer of Kings Point, the Academy Award-nominated documentary.", "excerpt": "Susannah Ludwig is a life coach who helps people navigate change with clarity, purpose and imagination.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/susannah-ludwig-0b35b32/?isSelfProfile=true", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.susannahludwig.com", "label": "susannahludwig.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/suzludwig/", "label": "@suzludwig"}], "photo": "/_blob/4717e6506544ae6632a3375a5b70e90e", "initials": "SL", "tags": ["advisory"], "sortKey": "susannah ludwig"}, {"id": 91, "name": "Tara Setmayer", "bio": "Tara Setmayer is a political commentator, strategist, and nationally recognized voice on democracy, women’s leadership, and civic engagement. With over 30 years of experience in political communications, she is the Co-Founder and CEO of The Seneca Project and Executive Director of the Seneca Democracy Initiative, two women-led organizations dedicated to defending democracy, amplifying women’s voices, and harnessing the power of storytelling and culture to inspire change.\n\nA frequent political analyst on national television networks and former guest host of The View, Tara brings extensive public policy experience from her years working on Capitol Hill as a congressional communications director. She has served as a Resident Scholar at the University of Virginia’s Center for Politics since 2020 and was a Resident Fellow at Harvard University’s Institute of Politics. Tara also serves on the Board of Directors of Whistleblower Aid, a nonprofit providing legal assistance to whistleblowers who expose wrongdoing and corruption.\n\nUnder her leadership, The Seneca Project won a 2025 Webby People’s Voice Award for its political ad American Girl. She also narrated the Emmy-nominated PBS documentary Dismantling Democracy.", "excerpt": "Tara Setmayer is a political commentator, strategist, and nationally recognized voice on democracy, women’s leadership, and civic engagement.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/tara-setmayer-a4036b5/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.tarasetmayer.com", "label": "tarasetmayer.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/thetarasetmayer", "label": "@thetarasetmayer"}], "photo": "/_blob/fa5e7a1e000000000000000000000a01", "initials": "TS", "tags": ["founders", "authors"], "sortKey": "tara setmayer"}, {"id": 92, "name": "Taylor Cromwell", "bio": "Writer & founder of Creator Diaries! I write about how people are building businesses in the creator economy and also work with companies like beehiiv, Later, & HubSpot to tell their stories.", "excerpt": "Writer & founder of Creator Diaries! I write about how people are building businesses in the creator economy and also work with companies…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/taylorcromwell/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://creatordiaries.beehiiv.com/", "label": "creatordiaries.beehiiv.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/creatordiariesmedia/", "label": "@creatordiariesmedia"}], "photo": "/_blob/07d4aab8d2279ffa6d884e559a481d7f", "initials": "TC", "tags": ["newsletters", "founders"], "sortKey": "taylor cromwell"}, {"id": 93, "name": "Vanessa Kroll Bennett", "bio": "Vanessa Kroll Bennett is a national bestselling author, podcaster and teen whisperer who helps adults raise tweens + teens with joy. Her new book Teenhood: Confessions & Lessons for the Trickiest Phase of Parenting will be published by Rodale Books on January 19, 2027. She is co-author of the bestselling book This Is So Awkward: Modern Puberty Explained, co-host of the This Is So Awkward podcast, and co-founder of Less Awkward, a company dedicated to making growing up more comfortable.", "excerpt": "Vanessa Kroll Bennett is a national bestselling author, podcaster and teen whisperer who helps adults raise tweens + teens with joy.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/vanessa-kroll-bennett-08729310a/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://vanessakrollbennett.com", "label": "vanessakrollbennett.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/vanessakrollbennett/", "label": "@vanessakrollbennett"}], "photo": "/_blob/5edfa8c60ad6df2abd4d65714a29c44f", "initials": "VB", "tags": ["authors", "podcasting", "founders"], "sortKey": "vanessa kroll bennett"}, {"id": 94, "name": "Vaughan Bagley", "bio": "Vaughan Bagley is a social impact strategist and essayist whose personal essays have appeared in Newsweek, HuffPost Personals, Spread the Jelly, and Modern Loss, among others. After serving for 6 years as the director of social impact strategy for MTV and Comedy Central, she founded her own social impact consultancy, North Star Strategy Group, to help brands turn good intentions into tangible actions. She is also the voice behind her weekly newsletter, Becoming Mom, where she pulls back the curtain on issues of maternal health, fertility, identity after motherhood, and mom guilt. She lives in Washington, D.C. with her husband, two little kiddos, and spunky Aussiedoodle, Finn.", "excerpt": "Vaughan Bagley is a social impact strategist and essayist whose personal essays have appeared in Newsweek, HuffPost Personals, Spread the…", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/vaughan-bagley-9b018b89/?isSelfProfile=true", "label": "LinkedIn"}, {"kind": "Website", "href": "https://becomingmomrealtalk.substack.com/", "label": "becomingmomrealtalk.substack.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/vaughanbag/", "label": "@vaughanbag"}], "photo": "/_blob/6b4e5eaa72a2db52575ac51f4909e7cc", "initials": "VB", "tags": ["newsletters", "founders", "advisory"], "sortKey": "vaughan bagley"}, {"id": 97, "name": "Andy McNicol", "bio": "Andy McNicol has represented New York Times best selling books for Sophia Amoruso, Chrissy Teigen, The Lady Gang, Tory Burch, and the #1 New York Times bestselling memoir, Melania and Me. She represents the writer and activist Tommy Dorfman, Jenna Lyons, as well as national bestsellers Alejandra Campoverdi, Tina Wells and Nicole Avante. She works with the lifestyle brands La Double J, Flamingo Estates and The Lakers Organization.\n\nAndy has spent her career in publishing, including 20 years with WME, where she was a partner and founding member of the Branded Lifestyle Group. She began her own strategic advisory — AMstudio in 2020, offering a holistic, 360-degree approach to multi-hyphenate talent and market activation.\n\nAndy and her work have been featured in The New York Times, Variety Magazine, and Adweek. She speaks regularly at industry events, on podcasts, and conferences on how to develop successful books and content platforms. Andy holds a bachelor’s degree in English and Art History from Yale University. She lives in Manhattan with her son Luke.", "excerpt": "Andy McNicol has represented New York Times best selling books for Sophia Amoruso, Chrissy Teigen, The Lady Gang, Tory Burch, and the #1 New York Times bestselling memoir, Melania and Me.", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/andymcnicol/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.amstudio.me/", "label": "amstudio.me"}], "photo": "/_blob/f8366f0c000000000000000000001110", "initials": "AM", "tags": ["founders", "authors", "advisory"], "sortKey": "andy mcnicol"}, {"id": 98, "name": "Helen Anders", "bio": "Helen Anders is Senior Creator Partnerships Manager at Kit (formerly ConvertKit), where she helps creators \"use email to scale connection – and their business\". She joined in 2019 as a product specialist, became an account manager, and moved to the Creator Partnerships team in 2022. She was promoted to senior manager in May 2024. Her work centers on helping YouTubers, authors and other creators move their social audiences onto email lists. She has publicly welcomed high-profile creators to Kit, including Lil Jon and his newsletter \"Wellness Wednesdays\". She also promoted the opening of Kit Studios Chicago, a space where Kit customers can create content. Before Kit, she was operations manager for a Northwestern Mutual financial practice, where she built client onboarding and communication systems. She has a degree in communications and public relations from Boise State University. She lives in Boise, Idaho, and spends her free time outdoors", "excerpt": "Helen Anders is Senior Creator Partnerships Manager at Kit (formerly ConvertKit), where she helps creators \"use email to scale connection – and their business\".", "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/helen-anders-a29a7167/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.kit.com", "label": "kit.com"}], "photo": "/_blob/ed611e51000000000000000000001615", "initials": "HA", "tags": ["communities", "marketing"], "sortKey": "helen anders"}, {"id": 99, "name": "Amelia Hay", "initials": "AH", "sortKey": "amelia hay", "photo": "/_blob/a3e11ab7000000000000000000000c05", "bio": "As the VP of Startup Programming and Investments at AgeTech Collaborative™ from AARP, Amelia leads various initiatives supporting the ecosystem, including sourcing startups, organizing pitch events, and executing the startup accelerator program. Additionally, she oversees all event and conference execution for the AgeTech Collaborative and manages startup investments. Prior to this role, Amelia spent over 20 years specializing in financial planning and analysis at MCI, Verizon, and AARP, focusing on business modeling and case building for new products and multi-year projects.", "excerpt": "As the VP of Startup Programming and Investments at AgeTech Collaborative™ from AARP, Amelia leads various initiatives supporting the ecosystem, including sourcing startups, organizing pitch events, and executing the startup accelerator program.", "tags": ["founders", "advisory"], "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/amelia-hay-4122874/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.aarp.org/", "label": "aarp.org"}]}, {"id": 100, "name": "Staci Alexander", "initials": "SA", "sortKey": "staci alexander", "photo": "/_blob/b4f22bc8000000000000000000000d06", "bio": "Staci is vice president of Thought Leadership at AARP working to amplify AARP’s voice in key conversations surrounding longevity, aging and equity. She leads a dynamic team of issue experts working across sectors to elevate new ideas, solutions and relationships. She has a long history of cultivating partnerships, forming alliances and leading national initiatives to engage key stakeholders in tackling aging issues through a variety of approaches including policy development, philanthropy and communication.\n\nPrior to joining AARP, Staci was assistant director with MacNeil/Lehrer Productions and senior associate of the Community Strategies Group for the Aspen Institute. She also has worked as a staffer in the United States Senate, a lobbyist for urban and rural affordable housing development and as a grantmaker. Staci is passionate about advancing equity and access for adults and children with developmental disabilities. She serves on the board of the Institute for Exceptional Care, an organization committed to improving healthcare outcomes for people with developmental disabilities. She also serves as a volunteer commissioner for the Fairfax County Redevelopment and Housing Authority in Fairfax County, Virginia.", "excerpt": "Staci is vice president of Thought Leadership at AARP working to amplify AARP’s voice in key conversations surrounding longevity, aging and equity.", "tags": ["advisory", "authors"], "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/staci-alexander-0971276/", "label": "LinkedIn"}]}, {"id": 101, "name": "Barbara Shipley", "initials": "BS", "sortKey": "barbara shipley", "photo": "/_blob/c5033cd9000000000000000000000e07", "bio": "In her capacity as Chief Brand Officer, Barbara Shipley brings more than 25 years of experience in branding, marketing and strategic communications to her role at AARP and is the chief architect of AARP’s enterprise-wide brand revitalization strategy. She oversees brand strategy, creative services, advertising, social media and events for AARP and leads the brand integration efforts, from the charitable Foundation and commercial relationships (through AARP Services) to the association’s 53 state offices. Before joining AARP in 2006, she managed the Washington, D.C. office of Ruder Finn, a global marketing and communications firm. Prior to that, she spent more than a decade in various leadership roles with Fleishman Hillard, Inc, one of the world’s largest strategic communications firms.", "excerpt": "In her capacity as Chief Brand Officer, Barbara Shipley brings more than 25 years of experience in branding, marketing and strategic communications to her role at AARP.", "tags": ["marketing", "advisory"], "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/barbara-shipley-7406a642/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.aarp.org/", "label": "aarp.org"}]}, {"id": 102, "name": "Carly Roszkowski", "initials": "CR", "sortKey": "carly roszkowski", "photo": "/_blob/d6144dea000000000000000000000f08", "bio": "Carly Roszkowski leads strategy and outcome development across AARP’s Financial Resilience and Work & Jobs issue areas, overseeing the programs that help Americans 50+ make sound financial decisions heading into retirement, protect their money from fraud, and stay in the workforce as long as they want to.\n\nShe brings more than 20 years of experience building business and integrated marketing strategies, brand campaigns, and strategic partnerships for major nonprofits. Before AARP, she ran marketing and communications at Teaching Strategies (an edtech company) and spent over a decade in consumer and B2B roles at Discovery Communications. She started her career in fundraising at the World Wildlife Fund.", "excerpt": "Carly Roszkowski leads strategy and outcome development across AARP’s Financial Resilience and Work & Jobs issue areas.", "tags": ["marketing", "advisory"], "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/carlyroszkowski/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.aarp.org/", "label": "aarp.org"}]}, {"id": 104, "name": "Shaniqua McClendon", "initials": "SM", "sortKey": "shaniqua mcclendon", "photo": "/_blob/cf7500aa000000000000000000003437", "bio": "Shaniqua McClendon is the Vice President of Politics for Crooked Media (home to the popular podcast, Pod Save America), a political strategist and sought-after speaker and commentator on media, politics, voting, and race. At Crooked Media, she leads their political strategy and civic engagement program (Vote Save America), and also created their successful 2020 volunteer engagement and fundraising program (Adopt a State).\n\nPrior to Crooked Media, Shaniqua served on Capitol Hill as a policy advisor to Senator Kay R. Hagan and Legislative Director to Congresswoman Alma S. Adams. While working for Rep. Adams, McClendon spearheaded the creation of the first-ever Congressional Bipartisan HBCU Caucus. She began her career as a White House Intern for President Barack Obama.", "excerpt": "Shaniqua McClendon is the Vice President of Politics for Crooked Media (home to the popular podcast, Pod Save America), a political strategist and sought-after speaker and commentator on media, politics, voting, and race.", "tags": ["podcasting", "advisory", "authors"], "links": [{"kind": "Website", "href": "https://www.shaniquamcclendon.com/", "label": "shaniquamcclendon.com"}, {"kind": "Instagram", "href": "https://www.instagram.com/shaniquam/", "label": "@shaniquam"}]}, {"id": 105, "name": "Nancy LeaMond", "initials": "NL", "sortKey": "nancy leamond", "photo": "/_blob/df7600ab000000000000000000003538", "bio": "As AARP's chief advocacy and engagement officer, Nancy LeaMond leads government relations and campaigns for AARP. She also oversees AARP’s public education initiatives as well as state and local advocacy and community engagement. Nancy has led several landmark advocacy campaigns for AARP, including the Fair Rx Prices Now campaign focused on lowering prescription drug prices. Her leadership in this arena positively influenced historic reforms in the 2022 Inflation Reduction Act including a cap on what seniors with Medicare drug plans pay out-of-pocket for their medicine and allowing Medicare to negotiate the price of some drugs for the first time ever. She also spearheaded the successful 2017 effort to protect Medicare and maintain important consumer protections under the Affordable Care Act. Nancy has been named by The Hill as a “Top Lobbyist” every year since 2011. Prior to coming to AARP, Nancy served as the chief of staff and assistant U.S. trade representative for congressional affairs at the Office of the United States Trade Representative. She worked extensively on health care and pension issues before entering the trade field, beginning her career in the Public Health Service, the Medicaid program, and the Department of Commerce. She also served in the Office of Management and Budget, the Department of Education and as chief of staff to a senior member of Congress.", "excerpt": "As AARP's chief advocacy and engagement officer, Nancy LeaMond leads government relations and campaigns for AARP.", "tags": ["advisory", "marketing"], "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/nancy-leamond-03494543/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.aarp.org", "label": "aarp.org"}]}, {"id": 106, "name": "Suzette Lohmeyer", "initials": "SL", "sortKey": "suzette lohmeyer", "photo": "/_blob/ef7700ac000000000000000000003639", "bio": "An experienced strategist, editor and writer who excels in taking complicated topics and making them understandable and interesting to the widest possible audience. An out-of-the-box thinker who enjoys experimenting with formats. Uses voice and tone to speak to an audience, not at them, to create a sense of community. Senior Editor, Writer, and Communications Strategist at AARP.", "excerpt": "An experienced strategist, editor and writer who excels in taking complicated topics and making them understandable and interesting to the widest possible audience.", "tags": ["journalism", "marketing"], "links": [{"kind": "LinkedIn", "href": "https://www.linkedin.com/in/suzette-lohmeyer-673b1922/", "label": "LinkedIn"}, {"kind": "Website", "href": "https://www.aarp.org/", "label": "aarp.org"}]}]